# syntax=docker/dockerfile:1
#
# The egress proxy: the only thing the agent container can talk to.
#
# The agent runs on a podman/docker *internal* network -- a bridge with no
# gateway, so the kernel has no route off it at all. This container is the one
# member of that network that is also attached to a normal network, and it will
# only forward to hosts named in `egress-allowlist`. That makes the allowlist a
# real control rather than a suggestion: it is not "the agent is asked to use a
# proxy", it is "there is no other way out".
#
# Build:
#   podman build -f Dockerfile.proxy -t agent-egress-proxy:1 .
#
# See README.md, "Restricting network egress".

FROM alpine:3.22

RUN set -eux; \
    apk add --no-cache tinyproxy

COPY <<'TINYPROXY_CONF' /etc/tinyproxy/tinyproxy.conf
# Runs unprivileged already (the container sets --user), so tinyproxy never
# needs to drop privileges itself -- which is just as well, because that would
# need CAP_SETUID and this container runs with --cap-drop ALL.
Port 8888
Listen 0.0.0.0
Timeout 600

# Log every connection to stdout: `podman logs -f agent-proxy` is then a live
# view of everywhere the agent tried to go, allowed or not. That visibility is
# half the value of running a proxy at all.
LogLevel Connect

MaxClients 64
ViaProxyName "agent-egress"

DefaultErrorFile "/usr/share/tinyproxy/default.html"
StatFile "/usr/share/tinyproxy/stats.html"

# Only clients on the internal network may use the proxy.
Allow 10.89.7.0/24

# CONNECT (i.e. every HTTPS request) may only target port 443. No tunnelling
# out to an SSH server or a database on some other port.
ConnectPort 443

# The allowlist. FilterDefaultDeny inverts the file's meaning: instead of "block
# these", it becomes "block everything except these".
Filter "/etc/tinyproxy/allowlist"
FilterType fnmatch
FilterDefaultDeny Yes
TINYPROXY_CONF

COPY egress-allowlist /etc/tinyproxy/allowlist

USER 65534:65534
EXPOSE 8888
ENTRYPOINT ["/usr/bin/tinyproxy", "-d", "-c", "/etc/tinyproxy/tinyproxy.conf"]
